<nav class="sticky top-0 z-50 w-full border-b border-slate-100 bg-white/90 shadow-sm backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-4">
    <a href="/" class="font-bold text-slate-900 hover:text-slate-700 transition-colors">
      Johan Valentin
    </a>

    <div class="hidden items-center gap-6 md:flex">
      <a href="/library" class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:-translate-y-1 transition-all">Proyecto de prueba</a>
      <a href="/#perfil" class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:-translate-y-1 transition-all">Perfil</a>
      <a href="/#habilidades" class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:-translate-y-1 transition-all">Habilidades</a>
      <a href="/#proyectos" class="text-sm font-medium text-slate-600 hover:text-slate-900 hover:-translate-y-1 transition-all">Proyectos</a>
    </div>

    <button
      id="mobile-menu-button"
      type="button"
      class="rounded-md p-2 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <span class="block h-0.5 w-5 bg-current transition-transform"></span>
      <span class="mt-1 block h-0.5 w-5 bg-current transition-opacity"></span>
      <span class="mt-1 block h-0.5 w-5 bg-current transition-transform"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white px-4 py-3 md:hidden">
    <div class="mx-auto flex max-w-5xl flex-col gap-1">
      <a href="/library" class="rounded px-3 py-2 text-sm font-medium text-slate-600 transition-all hover:translate-x-1 hover:bg-slate-50 hover:text-slate-900">Proyecto de prueba</a>
      <a href="/#perfil" class="rounded px-3 py-2 text-sm font-medium text-slate-600 transition-all hover:translate-x-1 hover:bg-slate-50 hover:text-slate-900">Perfil</a>
      <a href="/#habilidades" class="rounded px-3 py-2 text-sm font-medium text-slate-600 transition-all hover:translate-x-1 hover:bg-slate-50 hover:text-slate-900">Habilidades</a>
