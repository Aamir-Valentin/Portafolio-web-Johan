---
// Dashboard.astro
---

<section id="dashboard-view" class="animate-[library-fade-in_0.45s_ease-out]">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <a
      href="/library/book"
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-blue-500 hover:shadow-lg"
    >
      <span class="text-2xl transition-transform duration-200 group-hover:scale-110">📖</span>
      <h2 class="mt-2 font-bold text-slate-800">Libros</h2>
      <p class="text-sm text-slate-500">Catálogo y relaciones</p>
    </a>

    <a
      href="/library/author"
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-blue-500 hover:shadow-lg"
    >
      <span class="text-2xl transition-transform duration-200 group-hover:scale-110">✍️</span>
      <h2 class="mt-2 font-bold text-slate-800">Autores</h2>
      <p class="text-sm text-slate-500">Escritores registrados</p>
    </a>

    <a
      href="/library/category"
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-blue-500 hover:shadow-lg"
    >
      <span class="text-2xl transition-transform duration-200 group-hover:scale-110">🏷️</span>
      <h2 class="mt-2 font-bold text-slate-800">Categorías</h2>
      <p class="text-sm text-slate-500">Géneros y temas</p>
    </a>

    <a
      href="/library/editorial"
      class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-blue-500 hover:shadow-lg"
    >
      <span class="text-2xl transition-transform duration-200 group-hover:scale-110">🏢</span>
      <h2 class="mt-2 font-bold text-slate-800">Editoriales</h2>
      <p class="text-sm text-slate-500">Casas publicadoras</p>
    </a>
  </div>

  <button
    id="reset-library"
    class="mt-8 rounded border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-medium text-rose-600 transition-all duration-200 hover:-translate-y-0.5 hover:bg-rose-100 hover:shadow-sm"
  >
    Restablecer datos originales
  </button>
</section>

<script>
  import { resetDB } from "../../controllers/dbController.js";

  document.querySelector("#reset-library")?.addEventListener("click", () => {
    if (!confirm("¿Restablecer los datos originales de la biblioteca?")) return;
    resetDB();
    window.location.reload();
  });
</script>

<style>
  @keyframes library-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
