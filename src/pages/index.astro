---
import "../styles/global.css";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
// Swiper
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';
// Iconos
import IconGmail from '../components/icons/icon_gmail.astro';
import IconLinkedin from '../components/icons/icon_linkedin.astro';
import IconCredly from '../components/icons/icon_credly.astro';
// Badges
import ITE from "../assets/img/badges/ITE.png";
import Intro2IoT from "../assets/img/badges/Intro2IoT.png";
import CHB from "../assets/img/badges/CHB.png";
import IDS from "../assets/img/badges/IDS.png";
import I2CS from "../assets/img/badges/I2CS.png";
import NB from "../assets/img/badges/NB.png";
import PE1 from "../assets/img/badges/PE1.png";
import blob from "../assets/img/badges/blob.png";
import blob1 from "../assets/img/badges/blob1.png";
import CE1 from "../assets/img/badges/CE1.png";
// Foto
import Photo from "../assets/img/photo/photo-banner.png";

import { marked } from 'marked';
import { getCollection } from 'astro:content';
const proyectos = await getCollection('proyectos');
---

<Layout title="Portafolio">
	<main class="max-w-6xl mx-auto px-4 py-8 bg-slate-100 min-h-screen motion-safe:animate-library-fade-in shadow-sm">
		<section class="w-full min-w-0 mb-12 flex flex-col items-center gap-4 rounded-lg from-slate-400 to-slate-800 bg-gradient-to-r px-5 py-6 text-center shadow-sm md:flex-row md:gap-8 md:px-8 md:text-left">
			<Image src={Photo} alt="Foto de banner" class="h-auto w-44 sm:w-56 md:w-64 lg:w-72 shrink-0 mask-alpha mask-b-from-black mask-b-from-65% mask-b-to-transparent transition-all duration-700 hover:scale-105 hover:translate-x-2 peer"/>
			<div class="transition-all duration-500 tracking-tight md:peer-hover:tracking-wider md:peer-hover:translate-x-2">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
					Johan Aamir
				</h1>
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white/95 leading-tight mt-1">
					Valentin Garcia
				</h2>
				<p class="text-base sm:text-lg lg:text-xl text-slate-200 mt-2">
					Desarrollador Junior
				</p>
			</div>
		</section>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Columna Izquierda -->
			<aside
				class="md:col-span-1 bg-white p-6 rounded-lg shadow-sm border border-slate-200">
				<div class="pb-6">
					<h2 class="font-semibold text-lg mb-4 text-slate-900">
						Contactos
					</h2>
					<div class="grid grid-cols-3 md:grid-cols-1">
						<div>
						<a 
							href="mailto:johanvalentin718@gmail.com" 
							class="flex items-center gap-3 text-slate-600 hover:text-slate-900 hover:translate-x-2 duration-500 transition-all group flex-col md:flex-row text-center md:text-left">
							<IconGmail class="w-10 h-10 group-hover:rotate-10 transition-all" />
							<span class="text-xs md:text-sm font-medium break-all">johanvalentin718@gmail.com</span>
						</a>
						</div>
						<div>
						<a 
							href="https://www.linkedin.com/in/johan-aamir-valentin-garcia-/?isSelfProfile=true" 
							target="_blank"
							class="flex items-center gap-3 text-slate-600 hover:text-slate-900 hover:translate-x-2 duration-500 transition-all group flex-col md:flex-row text-center md:text-left">
							<IconLinkedin class="w-10 h-10 group-hover:rotate-10 transition-all" />
							<span class="text-xs md:text-sm font-medium break-all">johan-aamir-valentin-garcia</span>
						</a>
						</div>
						<div>
						<a 
							href="https://www.credly.com/users/aamir-valentin/badges/credly" 
							target="_blank"
							class="flex items-center gap-3 text-slate-600 hover:text-slate-900 hover:translate-x-2 duration-500 transition-all group flex-col md:flex-row text-center md:text-left">
							<IconCredly class="w-10 h-10 group-hover:rotate-10 transition-all" />
							<span class="text-xs md:text-sm font-medium break-all">Johan Aamir Valentin Garcia</span>
						</a>
						</div>
					</div>
				</div>
				<div>
					<h2 class="font-semibold text-lg mb-4 text-slate-900">
						Badges
					</h2>
					<div class="grid grid-cols-3 gap-3">
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={ITE} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={Intro2IoT} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={CHB} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={IDS} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={I2CS} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={NB} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={PE1} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={blob} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={blob1} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
						<div class="pb-2 hover:scale-105 transition-all duration-500">
							<Image src={CE1} alt="Badge IT Essentials" class="h-auto w-full shadow-md hover:shadow-xl rotate-x-15 -rotate-y-30 hover:rotate-x-1 hover:-rotate-y-1 max-w-22 object-contain duration-500"/>
						</div>
					</div>
				</div>
			</aside>

			<!-- Columna Derecha -->
			<section
				class="md:col-span-2 space-y-6 bg-white p-6 rounded-lg shadow-sm border border-slate-200"
			>
				<div id="perfil" class="scroll-mt-20">
					<h2 class="font-semibold text-xl mb-3 text-slate-900">
						Perfil profesional
					</h2>
					<p class="text-slate-600 text-justify">
						Soy un estudiante de la carrera de Desarrollo de
						Software, con conocimientos básicos en el desarrollo de
						base de datos relacionales, backend, frontend,
						aplicaciones web y páginas estáticas.
						Tengo 5 meses de experiencia desarrollando aplicaciones 
						web con base de datos MySQL y Laravel.
						Busco oportunidades para aplicar mis habilidades en entornos
						profesionales y crear soluciones creativas.
					</p>
				</div>
				<div>
					<h2 class="font-semibold text-xl mb-3 text-slate-900">
						Formación académica
					</h2>
					<p class="text-slate-600">
						Carrera profesional de Desarrollo de Software 5to ciclo - SENATI
					</p>
				</div>
				<div id="habilidades" class="scroll-mt-20">
					<h2 class="font-semibold text-xl mb-3 text-slate-900">
						Habilidades
					</h2>
					<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
						<div
							class="shadow-md rounded-md border border-slate-200 bg-slate-100 px-8 py-4 transition-all hover:scale-102 hover:shadow-xl duration-500">
							<h3
								class="font-semibold text-lg mb-3 text-slate-900"
							>
								Técnicas:
							</h3>
							<ul class="list-disc list-outside pl-5">
								<li class="text-slate-600">
									Desarrollo de aplicaciones web con arquitectura MVC y Laravel.
								</li>
								<li class="text-slate-600">
									Manejo de animaciones y transiciones con Tailwind CSS.
								</li>
								<li class="text-slate-600">
									Diseño de diagramas de entidad-relación y normalización de bases de datos (3NF).
								</li>
								<li class="text-slate-600">
									Construcción de programas de escritorio con Java y patrón de diseño DAO.
								</li>
							</ul>
						</div>
						<div
							class="shadow-md rounded-md border border-slate-200 bg-slate-100 px-8 py-4 transition-all hover:scale-102 hover:shadow-xl duration-500"
						>
							<h3
								class="font-semibold text-lg mb-3 text-slate-900"
							>
								Blandas:
							</h3>
							<ul class="list-disc list-outside pl-5">
								<li class="text-slate-600">
									Pensamiento crítico
								</li>
								<li class="text-slate-600">Escucha activa</li>
								<li class="text-slate-600">Proactividad</li>
								<li class="text-slate-600">Compañerismo</li>
								<li class="text-slate-600">Pensamiento creativo</li>
							</ul>
						</div>
					</div>
				</div>
				<div id="proyectos" class="scroll-mt-20">
					<h2 class="font-semibold text-xl mb-3 text-slate-900">
						Proyectos y experiencia
					</h2>
					<div class="bg-slate-100 shadow-md rounded-md p-2 w-full relative overflow-hidden swiper">
        <div class="swiper-wrapper">

            {proyectos.map((proyecto: any) => (
    <div class="swiper-slide px-8 md:px-14 py-4">
        
        <!-- Cabecera: Título a la izquierda y Tipo de proyecto a la derecha -->
        <div class="flex justify-between items-start gap-4 mb-1">
            <h3 class="font-semibold text-lg text-slate-900">
                {proyecto.data.title}
            </h3>
            <span class="text-xs font-semibold bg-slate-300 text-slate-700 px-3 py-1 rounded-full whitespace-nowrap">
                {proyecto.data.type}
            </span>
        </div>

        <!-- Fecha con su tonalidad actual -->
        <p class="text-xs text-slate-400 pb-3">
            Fecha: {proyecto.data.date}
        </p>

        <!-- Descripción en formato de texto o Markdown -->
        <div class="text-slate-600 pb-6 space-y-2 text-sm text-justify leading-relaxed">
            <p class="whitespace-pre-line" set:html={marked.parse(proyecto.data.description)}> </p>
        </div>

        <!-- Contenedor de Mockups / Imágenes corregido -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mx-2 md:mx-6">
            {proyecto.data.images && proyecto.data.images.map((imgObj: any) => {
                const imgPath = typeof imgObj === 'object' ? imgObj.image : imgObj;
                return (
                    <div class="rounded-md overflow-hidden shadow-md border-2 border-slate-200 transition-all hover:scale-102 bg-white hover:shadow-xl">
                        <img
                            src={imgPath}
                            alt={`Mockup de ${proyecto.data.title}`}
                            class="w-full h-62 md:h-65 object-cover"
                        />
                    </div>
                );
            })}
        </div>

    </div>
))}

        </div>
        <div class="swiper-pagination"></div>
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
    </div>
				</div>
				<script>
					import Swiper from 'swiper';
					import { Navigation, Pagination } from 'swiper/modules';

					new Swiper('.swiper', {
						modules: [Navigation, Pagination],
						loop: true,
						pagination: {
						el: '.swiper-pagination',
						clickable: true,
						},
						navigation: {
						nextEl: '.swiper-button-next',
						prevEl: '.swiper-button-prev',
						},
					});
				</script>
			</section>
		</div>
	</main>
</Layout>
