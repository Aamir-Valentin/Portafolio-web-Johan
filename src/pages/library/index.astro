---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import Dashboard from "../../components/library/Dashboard.astro";
---

<Layout>
<main class="min-h-screen max-w-6xl mx-auto bg-slate-50 px-4 py-8">
  <header class="mb-8 border-b border-slate-200 pb-6">
      <h1 class="text-2xl font-bold text-slate-800 transition-colors hover:text-blue-700">Sistema de Biblioteca</h1>
      <p class="text-slate-500">Selecciona una sección para administrar sus registros.</p>
    </header>

    <Dashboard />
  </main>
</Layout>
